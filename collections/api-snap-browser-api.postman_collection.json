          "name": "Capture Webpage Screenshot",
          "request": {
            "name": "Capture Webpage Screenshot",
            "description": {
              "content": "Capture a screenshot of any publicly accessible URL. Returns PNG or JPEG.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "screenshot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) The URL of the webpage to screenshot."
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "1280",
                  "description": "Viewport width in pixels (max 1920)."
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "720",
                  "description": "Viewport height in pixels (max 1080)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "png",
                  "description": "Image output format."
                },
                {
                  "disabled": false,
                  "key": "full_page",
                  "value": "false",
                  "description": "Capture the full scrollable page instead of only the viewport."
                }
              ],
              "variable": []
            },
