  "info": {
    "_postman_id": "8f08f7a2-030f-4b2c-b809-b157a6583d69",
    "name": "API Snap Browser Documents API",
    "description": "API Snap is a developer utility API that bundles 13+ common tools into a single REST API with one API key. Generate QR codes, resize images, capture screenshots, convert HTML to PDF, hash strings, generate UUIDs, extract URL metadata, and more. Free tier includes 100 API calls/month with no credit card required. All endpoints support CORS and return JSON (or binary where appropriate). Built for developers who want to ship faster.\n\nContact Support:\n Name: API Snap Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
